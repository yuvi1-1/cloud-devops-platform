{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "cloud-devops chart values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "global": {
      "type": "object",
      "properties": {
        "imageTag": {
          "type": "string"
        },
        "imagePullSecrets": {
          "type": "array"
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "podSecurityContext": {
      "type": "object"
    },
    "containerSecurityContext": {
      "type": "object"
    },
    "web": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 0
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^(|sha256:[a-f0-9]{64})$"
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "containerPort": {
          "type": "integer"
        },
        "runAsUser": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "type": "object",
          "properties": {
            "requests": {
              "type": "object"
            },
            "limits": {
              "type": "object"
            }
          }
        },
        "autoscaling": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "maxReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "targetCPUUtilizationPercentage": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "targetMemoryUtilizationPercentage": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 100
            },
            "behavior": {
              "type": "object"
            }
          },
          "required": [
            "enabled"
          ]
        },
        "podDisruptionBudget": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minAvailable": {
              "type": [
                "integer",
                "string"
              ]
            }
          }
        },
        "podAnnotations": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        }
      }
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 0
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^(|sha256:[a-f0-9]{64})$"
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "containerPort": {
          "type": "integer"
        },
        "runAsUser": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "type": "object",
          "properties": {
            "requests": {
              "type": "object"
            },
            "limits": {
              "type": "object"
            }
          }
        },
        "autoscaling": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "maxReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "targetCPUUtilizationPercentage": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "targetMemoryUtilizationPercentage": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 100
            },
            "behavior": {
              "type": "object"
            }
          },
          "required": [
            "enabled"
          ]
        },
        "podDisruptionBudget": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minAvailable": {
              "type": [
                "integer",
                "string"
              ]
            }
          }
        },
        "podAnnotations": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "logLevel": {
          "enum": [
            "fatal",
            "error",
            "warn",
            "info",
            "debug",
            "trace",
            "silent"
          ]
        },
        "seedDemoData": {
          "type": "boolean"
        },
        "enableLoadEndpoint": {
          "type": "boolean"
        },
        "rateLimitPerMinute": {
          "type": "integer",
          "minimum": 1
        },
        "shutdownDelayMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 25000
        },
        "extraEnv": {
          "type": "array"
        },
        "ingestToken": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "key": {
              "type": "string"
            },
            "value": {
              "type": "string",
              "anyOf": [
                {
                  "maxLength": 0
                },
                {
                  "minLength": 16
                }
              ]
            }
          }
        },
        "migrations": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "rollout": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "steps": {
              "type": "array",
              "minItems": 1
            },
            "analysis": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "prometheusAddress": {
                  "type": "string",
                  "format": "uri"
                },
                "successRate": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "maxP95LatencySeconds": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "interval": {
                  "type": "string",
                  "pattern": "^[0-9]+(s|m|h)$"
                },
                "failureLimit": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "internal",
            "external",
            "none"
          ]
        },
        "name": {
          "type": "string"
        },
        "user": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "passwordKey": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "external": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "host": {
              "type": "string"
            },
            "port": {
              "type": "integer"
            },
            "ssl": {
              "type": "boolean"
            },
            "caConfigMap": {
              "type": "string"
            },
            "caKey": {
              "type": "string"
            }
          }
        },
        "internal": {
          "type": "object",
          "properties": {
            "image": {
              "type": "object"
            },
            "storage": {
              "type": "object"
            },
            "resources": {
              "type": "object",
              "properties": {
                "requests": {
                  "type": "object"
                },
                "limits": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "externalSecrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "secretStoreRef": {
          "type": "object"
        },
        "refreshInterval": {
          "type": "string"
        },
        "databaseKey": {
          "type": "string"
        },
        "ingestTokenKey": {
          "type": "string"
        }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer"
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "host": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
        },
        "annotations": {
          "type": "object"
        },
        "tls": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "secretName": {
              "type": "string"
            },
            "clusterIssuer": {
              "type": "string"
            }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingressControllerNamespace": {
          "type": "string"
        },
        "monitoringNamespace": {
          "type": "string"
        },
        "databaseEgressCIDRs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "topologySpread": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxSkew": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "monitoring": {
      "type": "object",
      "properties": {
        "podMonitor": {
          "type": "object"
        },
        "prometheusRule": {
          "type": "object"
        },
        "grafanaDashboard": {
          "type": "object"
        }
      }
    },
    "tests": {
      "type": "object",
      "properties": {
        "image": {
          "type": "string"
        }
      }
    }
  }
}
